---
import { getCollection, render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
export async function getStaticPaths() {
  const publishedEntries = (await getCollection('guides')).filter((entry) => entry.data.published);
  return publishedEntries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const site = Astro.site ?? new URL('https://www.surrogacybutler.com/');
const description = d.seoDescription ?? d.description;
const allNews = await getCollection('news');
const related = d.relatedNews.map((slug) => allNews.find((n) => n.data.slug === slug && n.data.published)).filter((n) => Boolean(n));
const others = (await getCollection('guides')).filter((g) => g.data.published && g.data.slug !== d.slug).sort((a, b) => a.data.order - b.data.order);
const articleSchema = {
  '@type': 'Article',
  '@id': new URL(`/guides/${d.slug}/#article`, site).href,
  headline: d.title,
  description,
  dateModified: d.updatedDate.toISOString(),
  inLanguage: 'zh-CN',
  mainEntityOfPage: new URL(`/guides/${d.slug}/`, site).href,
  author: { '@type': 'Organization', name: '美宝管家编辑部' },
  publisher: { '@id': 'https://www.surrogacybutler.com/#organization' },
};
const faqSchema = {
  '@type': 'FAQPage',
  '@id': new URL(`/guides/${d.slug}/#faq`, site).href,
  mainEntity: d.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const schemas = d.faqs.length ? [articleSchema, faqSchema] : articleSchema;
---
<SiteLayout title={d.seoTitle ?? `${d.title} | 美宝管家`} description={description} path={`/guides/${d.slug}/`} schema={schemas}>
  <div class="scroll-progress" aria-hidden="true"><span></span></div>
  <SiteHeader />
  <main id="main-content" class="article-page section-shell">
    <nav class="breadcrumbs" aria-label="面包屑导航"><a href="/">首页</a><span aria-hidden="true">/</span><a href="/guides/">实用指南</a><span aria-hidden="true">/</span><span aria-current="page">本文</span></nav>
    <article>
      <header class="article-header">
        <p class="eyebrow">实用指南</p>
        <h1>{d.title}</h1>
        <p class="article-deck">{d.description}</p>
        <dl class="article-facts">
          <div><dt>最近更新</dt><dd><time datetime={d.updatedDate.toISOString()}>{d.updatedDate.toLocaleDateString('zh-CN', { timeZone: 'UTC' })}</time></dd></div>
          <div><dt>内容类型</dt><dd>常青指南（随法律与实务变化复核）</dd></div>
        </dl>
      </header>
      <div class="article-content"><Content /></div>
      {d.faqs.length > 0 && (
        <section aria-labelledby="guide-faq-title">
          <h2 id="guide-faq-title">常见问题</h2>
          {d.faqs.map((f) => (
            <div>
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </div>
          ))}
        </section>
      )}
      {related.length > 0 && (
        <section class="source-list" aria-labelledby="related-news-title">
          <h2 id="related-news-title">相关政策更新</h2>
          <ol>
            {related.map((n) => n && <li><a href={`/news/${n.data.slug}/`}>{n.data.title}</a><span>（{n.data.jurisdiction} · {n.data.legalStatus}）</span></li>)}
          </ol>
        </section>
      )}
      {others.length > 0 && (
        <section class="source-list" aria-labelledby="more-guides-title">
          <h2 id="more-guides-title">更多实用指南</h2>
          <ol>
            {others.map((g) => <li><a href={`/guides/${g.data.slug}/`}>{g.data.title}</a></li>)}
          </ol>
        </section>
      )}
      <p class="editorial-note">本文为一般信息整理，不构成医疗、法律、保险或财务建议。法律及政策变化可能快于网站更新；请核对来源和现行官方文件，并向相关专业人士确认。</p>
      <a class="article-back" href="/guides/">← 返回全部实用指南</a>
    </article>
  </main>
  <footer class="site-footer"><div class="footer-shell"><div class="footer-brand-block"><strong>美宝管家 <span>Your Surrogacy Butler</span></strong><p>美国辅助生殖与妊娠载体旅程咨询、协调与陪伴。</p></div><div class="footer-contact-block"><small>联系邮箱</small><a href="mailto:surrogacybutler@gmail.com">surrogacybutler@gmail.com</a></div><nav class="footer-links" aria-label="页脚导航"><a href="/">首页</a><a href="/guides/">实用指南</a><a href="/news/">近期时事</a><a href="/editorial-policy/">资料来源与更新原则</a><a href="/privacy.html">隐私声明</a></nav><p class="footer-disclaimer">本站内容仅作一般信息与经验分享，不构成医疗、法律、保险或财务建议。</p></div></footer>
</SiteLayout>
